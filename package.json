{
  "name": "@kompakkt/plugins",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "new-plugin": "bun run ./create-new-plugin.ts",
    "ci:build": "bun run ./build-all.ts",
    "postinstall": "bun run ./prepare-exports.ts",
    "update:kompakkt:common": "bun run update-git-dependency.ts -d @kompakkt/common -o Kompakkt -r Common -b main",
    "update:kompakkt:komponents": "bun run update-git-dependency.ts -d @kompakkt/komponents -o Kompakkt -r Komponents -b main"
  },
  "private": true,
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@angular/animations": "21.2.6",
    "@angular/cdk": "21.2.4",
    "@angular/common": "21.2.6",
    "@angular/compiler": "21.2.6",
    "@angular/core": "21.2.6",
    "@angular/forms": "21.2.6",
    "@angular/material": "21.2.4",
    "@angular/platform-browser": "21.2.6",
    "@angular/platform-browser-dynamic": "21.2.6",
    "@angular/router": "21.2.6",
    "@kompakkt/common": "git+https://github.com/Kompakkt/Common.git#be74f4e2fa2280029ebb0b89360427b7b383cdec",
    "@kompakkt/komponents": "git+https://github.com/Kompakkt/Komponents.git#3681d5c7674b6c059a9447356a3a50289ccd689f",
    "bson": "^7.2.0",
    "bson-objectid": "^2.0.4",
    "rxjs": "7.8.2",
    "slugify": "^1.6.6",
    "tslib": "^2.3.0",
    "uuid": "^14.0.0",
    "zone.js": "0.16.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.5",
    "@angular/cli": "21.2.5",
    "@angular/compiler-cli": "21.2.6",
    "@types/bun": "^1.2.0",
    "@types/jasmine": "~6.0.0",
    "jasmine-core": "~6.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "ng-packagr": "^21.2.5",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "oxlint-tsgolint": "^0.17.4",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "exports": {
    "./extender": "./extender/src/index.ts",
    "./hello-world": "./plugins/hello-world/src/index.ts",
    "./template": "./plugins/template/src/index.ts",
    "./privacy-and-contact": "./plugins/privacy-and-contact/src/index.ts",
    "./semantic-kompakkt-metadata": "./plugins/semantic-kompakkt-metadata/src/index.ts",
    "./sso-nfdi4culture": "./plugins/sso-nfdi4culture/src/index.ts",
    "./custom-branding": "./plugins/custom-branding/src/index.ts",
    "./oidc": "./plugins/oidc/src/index.ts",
    "./dfg-3d-mets": "./plugins/dfg-3d-mets/src/index.ts"
  }
}
