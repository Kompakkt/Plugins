{
  "name": "@kompakkt/plugins",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "check": "bun check",
    "new-plugin": "bun run ./create-new-plugin.ts",
    "ci:build": "bun run ./build-all.ts",
    "postinstall": "bun run ./prepare-exports.ts",
    "update:kompakkt:common": "bun run update-git-dependency.ts -d @kompakkt/common -o Kompakkt -r Common -b main",
    "update:kompakkt:komponents": "bun run update-git-dependency.ts -d @kompakkt/komponents -o Kompakkt -r Komponents -b main"
  },
  "private": true,
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@angular/animations": "22.2.3",
    "@angular/cdk": "22.2.4",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/material": "22.2.4",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-browser-dynamic": "22.2.3",
    "@angular/router": "22.2.3",
    "@kompakkt/common": "git+https://github.com/Kompakkt/Common.git#49b7d222f9d6edd719ae7183ba53c96acedd9d0f",
    "@kompakkt/komponents": "git+https://github.com/Kompakkt/Komponents.git#a8299aa77713b01270aa43d2a69a3a6ba26959e7",
    "bson": "^7.2.0",
    "bson-objectid": "^2.0.4",
    "rxjs": "7.8.2",
    "slugify": "^1.6.6",
    "tslib": "^2.3.0",
    "uuid": "^14.0.0",
    "zone.js": "0.16.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.3",
    "@types/bun": "^1.2.0",
    "@types/jasmine": "~6.0.0",
    "jasmine-core": "~6.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "ng-packagr": "^22.2.5",
    "oxlint": "^1.57.0",
    "oxlint-tsgolint": "^0.17.4",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
  },
  "exports": {
    "./extender": "./extender/src/index.ts",
    "./hello-world": "./plugins/hello-world/src/index.ts",
    "./template": "./plugins/template/src/index.ts",
    "./privacy-and-contact": "./plugins/privacy-and-contact/src/index.ts",
    "./semantic-kompakkt-metadata": "./plugins/semantic-kompakkt-metadata/src/index.ts",
    "./sso-nfdi4culture": "./plugins/sso-nfdi4culture/src/index.ts",
    "./custom-branding": "./plugins/custom-branding/src/index.ts",
    "./oidc": "./plugins/oidc/src/index.ts",
    "./dfg-3d-mets": "./plugins/dfg-3d-mets/src/index.ts"
  },
  "trustedDependencies": [
    "@kompakkt/common"
  ]
}
