  "cli": {
    "analytics": false,
    "packageManager": "bun"
  },
  "schematics": {
    "@schematics/angular:application": {
      "strict": true,
      "fileNameStyleGuide": "2016"
    },
    "@schematics/angular:component": {
      "skipTests": true,
      "style": "scss",
      "addTypeToClassName": true,
      "type": "component"
    },
    "@schematics/angular:directive": {
      "skipTests": true,
      "addTypeToClassName": true,
      "type": "directive"
    },
    "@schematics/angular:service": {
      "skipTests": true,
      "addTypeToClassName": true,
      "type": "service"
    },
    "@schematics/angular:guard": {
      "skipTests": true,
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "skipTests": true,
      "typeSeparator": ".",
      "functional": true
    },
    "@schematics/angular:module": {
      "skipTests": true,
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "skipTests": true,
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "skipTests": true,
      "typeSeparator": "."
    }
  }
}
